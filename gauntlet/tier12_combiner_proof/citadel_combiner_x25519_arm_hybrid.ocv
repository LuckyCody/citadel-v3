(* Citadel hybrid combiner — X25519 arm, FAITHFUL (packet 017 + review 017-R).
   Mirror of the verified faithful ML-KEM arm, with the surviving component swapped
   to X25519 (modeled as a DHKEM whose shared secret is `dh_secret`). Addresses the
   same review flags for this arm:

     F1 — the KDF binds the hybrid-ciphertext DIGEST SHA3-256(x25519_ct||mlkem_ct)
          and context. SHA3-256 is modeled as a fixed collision-resistant function
          (composed collision rule), so the binding is derived and its P_sha3 loss is
          explicit, not assumed from a bare ROM.
     F2 — the decapsulation oracle takes the FULL hybrid ciphertext and rejects only
          the exact challenge pair ct1-star / ct2-star, PERMITTING and correctly
          answering the load-bearing hybrid CCA query [broken-ML-KEM ct' , x25519 ct*].

   Theorem (faithful): if X25519-DHKEM is IND-CCA2 and SHA3-256 is collision-resistant,
   the combiner key K is secret under full hybrid-ciphertext CCA even if ML-KEM-768 is
   fully broken (adversary CHOOSES the ML-KEM secret ss1 AND its challenge ciphertext).

   SCOPE (019-R falsification audit): load-bearing for THIS secrecy theorem is the
   BROKEN-component (ML-KEM) ciphertext binding; the surviving-component ciphertext
   and context are bound faithfully-to-construction but not individually necessary.
   The fixed PROTOCOL_ID/"|aes|" domain label is a CONSTANT here and is NOT modeled
   (cross-protocol/domain separation is a separate, out-of-scope property).

   PREMISE NOTE: the X25519-DHKEM IND-CCA2 premise is NOT re-derived here; it is the
   published GDH+ROM result (examples/hpke/dhkem.base.indcca2-lr.m4.ocv), same
   epistemic status as the ML-KEM arm's ML-KEM-768 IND-CCA2 premise. A raw-Curve25519
   grounding of this premise (subgroup/low-order/all-zero rejection) is future work;
   the abstract prime-order attempt is parked (see citadel_combiner_x25519_gdh_attempt.ocv).

   `dh_*` names denote the surviving X25519-DHKEM; the broken ML-KEM secret is the
   adversary-supplied `ss1` bitstring. Still a ROM model of HKDF. *)

type dh_keyseed    [fixed, large].
type dh_pkey       [bounded].
type dh_skey       [bounded].
type dh_encapseed  [bounded].
type dh_secret     [fixed, large].
type dh_ciphertext [bounded].
type dh_output     [bounded].

proba P_dh_indcca2.
proba P_dh_keycoll.
proba P_dh_ctcoll.

expand KEM_all_args(
  dh_keyseed, dh_pkey, dh_skey, dh_encapseed, dh_secret,
  dh_ciphertext, dh_output,
  dh_pkgen, dh_skgen, dh_encap, dh_encap_r, dh_pair, dh_decap,
  dh_injbot, P_dh_keycoll, P_dh_ctcoll).

param N_keys, N_enc, N_dec.
table DH_challenge(N_keys, dh_ciphertext, dh_secret).

equiv(dhkem_indcca2_assumption)
  foreach i <= N_keys do seed <-R dh_keyseed; (
    PublicKey() := return(dh_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: dh_ciphertext) := return(dh_decap(c, dh_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: dh_pkey) := r <-R dh_encapseed; return(dh_encap_r(pk, r)) [all]
  <=(P_dh_indcca2(time, N_keys, #Encaps, #Decap))=>
  foreach i <= N_keys do seed <-R dh_keyseed; (
    PublicKey() := return(dh_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: dh_ciphertext) :=
        get DH_challenge(=i, =c, s) in return(dh_injbot(s))
        else return(dh_decap(c, dh_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: dh_pkey) :=
        find i2 <= N_keys suchthat defined(seed[i2]) && pk = dh_pkgen(seed[i2]) then (
          r <-R dh_encapseed;
          let dh_pair(junk, c) = dh_encap_r(pk, r) in
          s <-R dh_secret;
          insert DH_challenge(i2, c, s);
          return(dh_pair(s, c)) )
        else ( r <-R dh_encapseed; return(dh_encap_r(pk, r)) ).

(* HKDF info binds BOTH ciphertext portions and the context. SHA3-256 is modeled
   as a fixed (unkeyed) collision-resistant function; the composed collision rule
   below lifts SHA3 CR through the injective kdf_info constructor so CryptoVerif can
   match the equality generated by ROM_hash_3. This is not an extra assumption:
   equality with unequal contexts is impossible by [data]; with equal contexts and
   unequal ciphertexts it is exactly a SHA3-256 collision (loss P_sha3_coll). Per
   review 017-R / F1, this EXPOSES the SHA3 collision term in the advantage bound. *)
type x_ciphertext      [fixed].
type hybrid_ciphertext [bounded].
type ct_digest         [fixed, large].

fun hybrid_ct(x_ciphertext, dh_ciphertext): hybrid_ciphertext [data].
fun sha3_256(hybrid_ciphertext): ct_digest.
fun kdf_info(ct_digest, bitstring): bitstring [data].

proba P_sha3_coll.

collision forall x:hybrid_ciphertext, y:hybrid_ciphertext,
                 cx:bitstring, cy:bitstring;
  return(kdf_info(sha3_256(x), cx) = kdf_info(sha3_256(y), cy))
  <=(P_sha3_coll)=>
  return((x = y) && (cx = cy)).

(* Combiner KDF as a random oracle over (ss1, ss2, info). *)
type hashkey [fixed].
type kdfkey  [fixed, large].
expand ROM_hash_3(hashkey, bitstring, dh_secret, bitstring, kdfkey, kdf, kdf_oracle, N_kdf).

query secret K.

proof {
  crypto dhkem_indcca2_assumption;
  crypto rom(kdf);
  simplify;
  success
}

process
  Ostart(ct1star: x_ciphertext) :=
    hk  <-R hashkey;
    seed <-R dh_keyseed;
    let pk = dh_pkgen(seed) in
    r <-R dh_encapseed;
    let dh_pair(ss2: dh_secret, ct: dh_ciphertext) = dh_encap_r(pk, r) in
    (* ML-KEM is fully broken: the ADVERSARY supplies the broken-component (ML-KEM)
       challenge ciphertext ct1star (Ostart parameter), committed at setup — as
       IND-CCA2 requires the challenge ciphertext fixed BEFORE decap queries. Prevents
       decapsulating (ct1*, ct) then declaring that same ct1* the challenge.
       (019-R: adversary-chosen, not uniformly sampled.) *)
    return(pk, ct, ct1star);         (* publish pk, X25519 (surviving) ct, ML-KEM (broken) ct *)
  (
    (run kdf_oracle(hk))
  | (* Full hybrid-ciphertext CCA decapsulation. Rejects ONLY the exact challenge
       pair ct1-star / ct2-star; permits [ct1' != ct1-star, ct2-star] and answers
       via the ciphertext-bound KDF over the query transcript. *)
    (foreach id <= N_dec do
      ODecap(ct1q: x_ciphertext, ss1q: bitstring, c: dh_ciphertext, ctxq: bitstring) :=
        if ct1q = ct1star && c = ct then yield else
        let dh_injbot(ss2q: dh_secret) = dh_decap(c, dh_skgen(seed)) in (
          let ctq: hybrid_ciphertext = hybrid_ct(ct1q, c) in
          let infoq: bitstring = kdf_info(sha3_256(ctq), ctxq) in
          return(kdf(hk, ss1q, ss2q, infoq))
        ) else yield)
  | (* One challenge: ML-KEM broken => adversary supplies ss1 (the ML-KEM secret)
       and its ciphertext ct1star; K binds both ciphertexts via SHA3 + info.
       Adversary gets ct (the surviving X25519 ct, published), never K. *)
    (OChal(ss1: bitstring, context: bitstring) :=
      let ctstar: hybrid_ciphertext = hybrid_ct(ct1star, ct) in
      let info: bitstring = kdf_info(sha3_256(ctstar), context) in
      let K: kdfkey = kdf(hk, ss1, ss2, info) in
      yield)
  )
