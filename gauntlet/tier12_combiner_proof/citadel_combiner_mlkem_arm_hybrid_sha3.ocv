(* Citadel hybrid combiner — ML-KEM arm, FAITHFUL (packet 016 + review 017-R).
   Upgrades citadel_combiner_mlkem_arm.ocv to address the adversarial-review flags:

     F1 — the KDF binds the hybrid-ciphertext DIGEST SHA3-256(x25519_ct||mlkem_ct)
          and the context. SHA3-256 is modeled as a fixed collision-resistant
          function (composed collision rule), so the binding is derived and its
          P_sha3 loss is explicit, not assumed from a bare ROM.
     F2 — the decapsulation oracle takes the FULL hybrid ciphertext and rejects only
          the exact challenge pair ct1-star / ct2-star. It PERMITS the load-bearing
          hybrid CCA query [ct1' != ct1-star, ct2-star] and answers it through the
          ciphertext-bound KDF — the query the secrets-only model wrongly excluded.

   Theorem (faithful): if ML-KEM-768 is IND-CCA2 and SHA3-256 is collision-resistant,
   the combiner key K is secret under full hybrid-ciphertext CCA even if X25519 is
   fully broken (adversary CHOOSES ss1 AND the X25519 challenge ciphertext ct1star).

   SCOPE (019-R falsification audit): machine-checked as load-bearing for THIS
   secrecy theorem is the BROKEN-component ciphertext binding; the surviving-
   component ciphertext and context are bound faithfully-to-construction but are not
   individually necessary for secrecy (removing them still proves, with a larger
   guessing term). The fixed PROTOCOL_ID/"|aes|" domain label is a CONSTANT here and
   is NOT modeled — cross-protocol/domain separation is a separate property, out of
   scope for this single-protocol key-secrecy proof. Still a ROM model of HKDF. *)

type ml_keyseed    [fixed, large].
type ml_pkey       [bounded].
type ml_skey       [bounded].
type ml_encapseed  [bounded].
type ml_secret     [fixed, large].
type ml_ciphertext [bounded].
type ml_output     [bounded].

proba P_ml_indcca2.
proba P_ml_keycoll.
proba P_ml_ctcoll.

expand KEM_all_args(
  ml_keyseed, ml_pkey, ml_skey, ml_encapseed, ml_secret,
  ml_ciphertext, ml_output,
  ml_pkgen, ml_skgen, ml_encap, ml_encap_r, ml_pair, ml_decap,
  ml_injbot, P_ml_keycoll, P_ml_ctcoll).

param N_keys, N_enc, N_dec.
table ML_challenge(N_keys, ml_ciphertext, ml_secret).

equiv(mlkem_indcca2_assumption)
  foreach i <= N_keys do seed <-R ml_keyseed; (
    PublicKey() := return(ml_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: ml_ciphertext) := return(ml_decap(c, ml_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: ml_pkey) := r <-R ml_encapseed; return(ml_encap_r(pk, r)) [all]
  <=(P_ml_indcca2(time, N_keys, #Encaps, #Decap))=>
  foreach i <= N_keys do seed <-R ml_keyseed; (
    PublicKey() := return(ml_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: ml_ciphertext) :=
        get ML_challenge(=i, =c, s) in return(ml_injbot(s))
        else return(ml_decap(c, ml_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: ml_pkey) :=
        find i2 <= N_keys suchthat defined(seed[i2]) && pk = ml_pkgen(seed[i2]) then (
          r <-R ml_encapseed;
          let ml_pair(junk, c) = ml_encap_r(pk, r) in
          s <-R ml_secret;
          insert ML_challenge(i2, c, s);
          return(ml_pair(s, c)) )
        else ( r <-R ml_encapseed; return(ml_encap_r(pk, r)) ).

(* HKDF info binds BOTH ciphertext portions and the context. SHA3-256 is modeled
   as a fixed (unkeyed) collision-resistant function; the composed collision rule
   below lifts SHA3 CR through the injective kdf_info constructor so CryptoVerif can
   match the equality generated by ROM_hash_3. This is not an extra assumption:
   equality with unequal contexts is impossible by [data]; with equal contexts and
   unequal ciphertexts it is exactly a SHA3-256 collision (loss P_sha3_coll). Per
   review 017-R / F1, this EXPOSES the SHA3 collision term in the advantage bound. *)
type x_ciphertext      [fixed].
type hybrid_ciphertext [bounded].
type ct_digest         [fixed, large].

fun hybrid_ct(x_ciphertext, ml_ciphertext): hybrid_ciphertext [data].
fun sha3_256(hybrid_ciphertext): ct_digest.
fun kdf_info(ct_digest, bitstring): bitstring [data].

proba P_sha3_coll.

collision forall x:hybrid_ciphertext, y:hybrid_ciphertext,
                 cx:bitstring, cy:bitstring;
  return(kdf_info(sha3_256(x), cx) = kdf_info(sha3_256(y), cy))
  <=(P_sha3_coll)=>
  return((x = y) && (cx = cy)).

(* Combiner KDF as a random oracle over (ss1, ss2, info). *)
type hashkey [fixed].
type kdfkey  [fixed, large].
expand ROM_hash_3(hashkey, bitstring, ml_secret, bitstring, kdfkey, kdf, kdf_oracle, N_kdf).

query secret K.

proof {
  crypto mlkem_indcca2_assumption;
  crypto rom(kdf);
  simplify;
  success
}

process
  Ostart(ct1star: x_ciphertext) :=
    hk  <-R hashkey;
    seed <-R ml_keyseed;
    let pk = ml_pkgen(seed) in
    r <-R ml_encapseed;
    let ml_pair(ss2: ml_secret, ct: ml_ciphertext) = ml_encap_r(pk, r) in
    (* X25519 is fully broken: the ADVERSARY supplies the X25519 challenge
       ciphertext ct1star (Ostart parameter), and it is committed at setup — as
       IND-CCA2 requires the challenge ciphertext fixed BEFORE decap queries. This
       prevents decapsulating (ct1*, ct) then declaring that same ct1* the
       challenge. (019-R: adversary-chosen, not uniformly sampled.) *)
    return(pk, ct, ct1star);         (* publish pk, ML-KEM challenge ct, X25519 challenge ct *)
  (
    (run kdf_oracle(hk))
  | (* Full hybrid-ciphertext CCA decapsulation. Rejects ONLY the exact challenge
       pair ct1-star / ct2-star; permits [ct1' != ct1-star, ct2-star] and answers
       via the ciphertext-bound KDF over the query transcript. *)
    (foreach id <= N_dec do
      ODecap(ct1q: x_ciphertext, ss1q: bitstring, c: ml_ciphertext, ctxq: bitstring) :=
        if ct1q = ct1star && c = ct then yield else
        let ml_injbot(ss2q: ml_secret) = ml_decap(c, ml_skgen(seed)) in (
          let ctq: hybrid_ciphertext = hybrid_ct(ct1q, c) in
          let infoq: bitstring = kdf_info(sha3_256(ctq), ctxq) in
          return(kdf(hk, ss1q, ss2q, infoq))
        ) else yield)
  | (* One challenge: X25519 broken => adversary supplies ss1 and the X25519
       ciphertext ct1; K binds both ciphertexts via SHA3 + info. Adversary gets ct
       (published), never K. *)
    (OChal(ss1: bitstring, context: bitstring) :=
      let ctstar: hybrid_ciphertext = hybrid_ct(ct1star, ct) in
      let info: bitstring = kdf_info(sha3_256(ctstar), context) in
      let K: kdfkey = kdf(hk, ss1, ss2, info) in
      yield)
  )
