(* Citadel hybrid combiner — P-384 arm, ACTIVE CTD2 construction (packet 033 / P5,
   suite 0xA4 = P-384 + ML-KEM-1024). Direct analogue of
   citadel_combiner_ctd2_x25519_arm.ocv, re-instanced for the CNSA-aligned suite.

   Surviving component = P-384 ECDH (modeled as a DHKEM; `dh_*`). Broken component =
   ML-KEM-1024: the adversary supplies its secret (`ss_mlkem`, a bitstring) and its
   ciphertext (`ct_mlkem`). Models the DEFAULT production KDF for 0xA4 in wire_v2.rs.

   PRODUCTION ORDER (0xA4 provider, kem_p384.rs / wire_v2.rs): both the combined IKM
   (p384_ss(48) || mlkem_ss(32)) and the bound kem_ct (p384_eph_pk || mlkem_ct) put the
   P-384 component FIRST, exactly as the 0xA3 X25519 arm puts X25519 first. This file
   binds them in that order:
     ikm-order    : kdf(hk, ss_p384, ss_mlkem, transcript)          (P-384 first)
     transcript   : ctd2_transcript(header, ct_p384, ct_mlkem, context)  (P-384 first)

   Theorem: if P-384-DHKEM is IND-CCA2, the CTD2 combiner key K is secret under full
   hybrid-ciphertext CCA even if ML-KEM-1024 is fully broken (adversary CHOOSES the
   ML-KEM secret, the ML-KEM challenge ciphertext, and the header). ROM model of HKDF;
   ciphertext bound DIRECTLY (length-delimited/injective), no SHA3 term.

   WHY THIS ARM IS AN UPGRADE OVER THE X25519 ARM, NOT A RELABEL (spec eem/033 §5):
   CryptoVerif's KEM/prime-order abstraction is *unfaithful* to Curve25519 (cofactor 8,
   low-order points, all-zero/non-contributory rejection), which is exactly why the
   raw-GDH grounding for X25519 (citadel_combiner_x25519_gdh_attempt.ocv) stays PARKED
   as an idealization. P-384 has COFACTOR 1: the group is prime-order with no low-order
   subgroup, so the abstract prime-order/DHKEM model is faithful to the shipped curve and
   the fidelity gap that parked the X25519 grounding DOES NOT EXIST here. The downstream
   seven-point low-order rejection suite (kem.rs:447-514) has no P-384 analogue and needs
   none; it is replaced by SEC1 on-curve/not-identity validation in from_sec1_bytes. *)

type dh_keyseed    [fixed, large].
type dh_pkey       [bounded].
type dh_skey       [bounded].
type dh_encapseed  [bounded].
type dh_secret     [fixed, large].
type dh_ciphertext [bounded].
type dh_output     [bounded].

proba P_dh_indcca2.
proba P_dh_keycoll.
proba P_dh_ctcoll.

expand KEM_all_args(
  dh_keyseed, dh_pkey, dh_skey, dh_encapseed, dh_secret,
  dh_ciphertext, dh_output,
  dh_pkgen, dh_skgen, dh_encap, dh_encap_r, dh_pair, dh_decap,
  dh_injbot, P_dh_keycoll, P_dh_ctcoll).

param N_keys, N_enc, N_dec.
table DH_challenge(N_keys, dh_ciphertext, dh_secret).

equiv(dhkem_indcca2_assumption)
  foreach i <= N_keys do seed <-R dh_keyseed; (
    PublicKey() := return(dh_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: dh_ciphertext) := return(dh_decap(c, dh_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: dh_pkey) := r <-R dh_encapseed; return(dh_encap_r(pk, r)) [all]
  <=(P_dh_indcca2(time, N_keys, #Encaps, #Decap))=>
  foreach i <= N_keys do seed <-R dh_keyseed; (
    PublicKey() := return(dh_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: dh_ciphertext) :=
        get DH_challenge(=i, =c, s) in return(dh_injbot(s))
        else return(dh_decap(c, dh_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: dh_pkey) :=
        find i2 <= N_keys suchthat defined(seed[i2]) && pk = dh_pkgen(seed[i2]) then (
          r <-R dh_encapseed;
          let dh_pair(junk, c) = dh_encap_r(pk, r) in
          s <-R dh_secret;
          insert DH_challenge(i2, c, s);
          return(dh_pair(s, c)) )
        else ( r <-R dh_encapseed; return(dh_encap_r(pk, r)) ).

(* CTD2 length-delimited transcript, PRODUCTION ORDER: P-384 ciphertext first,
   ML-KEM-1024 ciphertext second. Injective [data] constructor models the unambiguous
   length-prefixed parsing of wire_v2::kdf_transcript over the full kem_ct. *)
type mlkem_ct_t [fixed].            (* broken ML-KEM-1024 ciphertext component *)
type header_t   [fixed].
fun ctd2_transcript(header_t, dh_ciphertext, mlkem_ct_t, bitstring): bitstring [data].

(* Combiner KDF (HKDF-SHA256, fixed salt) as a random oracle over
   (ikm = ss_p384 || ss_mlkem, info = transcript). P-384 secret first. *)
type hashkey [fixed].
type kdfkey  [fixed, large].
expand ROM_hash_3(hashkey, dh_secret, bitstring, bitstring, kdfkey, kdf, kdf_oracle, N_kdf).

query secret K.

proof {
  crypto dhkem_indcca2_assumption;
  crypto rom(kdf);
  simplify;
  success
}

process
  Ostart(ct_mlkem_star: mlkem_ct_t, hdrstar: header_t) :=
    hk  <-R hashkey;
    seed <-R dh_keyseed;
    let pk = dh_pkgen(seed) in
    r <-R dh_encapseed;
    let dh_pair(ss_p384: dh_secret, ct_p384: dh_ciphertext) = dh_encap_r(pk, r) in
    (* ML-KEM-1024 fully broken: the ADVERSARY supplies the ML-KEM challenge ciphertext
       ct_mlkem_star and the header hdrstar, committed at setup. *)
    return(pk, ct_p384, ct_mlkem_star, hdrstar);
  (
    (run kdf_oracle(hk))
  | (* Full hybrid-ciphertext CCA decapsulation over the CTD2 transcript. The
       adversary submits (header, P-384 ct, ML-KEM ct, ML-KEM secret, context).
       Rejects ONLY the exact challenge P-384 ciphertext (the surviving KEM's
       challenge); permits everything else, answering via the P-384-first KDF. *)
    (foreach id <= N_dec do
      ODecap(hdrq: header_t, cx: dh_ciphertext, ss_mlkem_q: bitstring,
             ct_mlkem_q: mlkem_ct_t, ctxq: bitstring) :=
        if cx = ct_p384 && ct_mlkem_q = ct_mlkem_star then yield else
        let dh_injbot(ss_p384_q: dh_secret) = dh_decap(cx, dh_skgen(seed)) in (
          let tq: bitstring = ctd2_transcript(hdrq, cx, ct_mlkem_q, ctxq) in
          return(kdf(hk, ss_p384_q, ss_mlkem_q, tq))
        ) else yield)
  | (* One challenge: adversary supplies the broken ML-KEM secret ss_mlkem and the
       context; the CTD2 transcript binds header + P-384 ct (first) + ML-KEM ct
       (second) + context. Adversary gets ct_p384 (published), never K. *)
    (OChal(ss_mlkem: bitstring, context: bitstring) :=
      let t: bitstring = ctd2_transcript(hdrstar, ct_p384, ct_mlkem_star, context) in
      let K: kdfkey = kdf(hk, ss_p384, ss_mlkem, t) in
      yield)
  )
