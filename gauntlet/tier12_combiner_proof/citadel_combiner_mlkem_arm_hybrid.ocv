(* Citadel hybrid combiner — ML-KEM arm, FAITHFUL (packet 016 + review 017-R).
   Upgrades citadel_combiner_mlkem_arm.ocv to address the adversarial-review flags:

     F1 — the KDF now binds the FULL hybrid ciphertext and context, exactly as the
          real HKDF info = (PROTOCOL_ID||"|aes|", SHA3-256(x25519_ct||mlkem_ct),
          context). SHA3-256 is modeled as a collision-resistant public hash, so the
          binding is derived, not assumed from a bare ROM.
     F2 — the decapsulation oracle takes the FULL hybrid ciphertext and rejects only
          the exact challenge pair ct1-star / ct2-star. It PERMITS the load-bearing
          hybrid CCA query [ct1' != ct1-star, ct2-star] and answers it through the
          ciphertext-bound KDF — the query the secrets-only model wrongly excluded.

   Theorem (faithful): if ML-KEM-768 is IND-CCA2 and SHA3-256 is collision-resistant,
   the combiner key K is secret under full hybrid-ciphertext CCA even if X25519 is
   fully broken (adversary supplies ss1 and the X25519 ciphertext ct1).

   Still a ROM model of HKDF; still the ML-KEM arm (X25519 arm is packet 017). *)

type ml_keyseed    [fixed, large].
type ml_pkey       [bounded].
type ml_skey       [bounded].
type ml_encapseed  [bounded].
type ml_secret     [fixed, large].
type ml_ciphertext [bounded].
type ml_output     [bounded].

proba P_ml_indcca2.
proba P_ml_keycoll.
proba P_ml_ctcoll.

expand KEM_all_args(
  ml_keyseed, ml_pkey, ml_skey, ml_encapseed, ml_secret,
  ml_ciphertext, ml_output,
  ml_pkgen, ml_skgen, ml_encap, ml_encap_r, ml_pair, ml_decap,
  ml_injbot, P_ml_keycoll, P_ml_ctcoll).

param N_keys, N_enc, N_dec.
table ML_challenge(N_keys, ml_ciphertext, ml_secret).

equiv(mlkem_indcca2_assumption)
  foreach i <= N_keys do seed <-R ml_keyseed; (
    PublicKey() := return(ml_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: ml_ciphertext) := return(ml_decap(c, ml_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: ml_pkey) := r <-R ml_encapseed; return(ml_encap_r(pk, r)) [all]
  <=(P_ml_indcca2(time, N_keys, #Encaps, #Decap))=>
  foreach i <= N_keys do seed <-R ml_keyseed; (
    PublicKey() := return(ml_pkgen(seed))
  | foreach id <= N_dec do
      Decap(c: ml_ciphertext) :=
        get ML_challenge(=i, =c, s) in return(ml_injbot(s))
        else return(ml_decap(c, ml_skgen(seed))) )
  | foreach ie <= N_enc do
      Encaps(pk: ml_pkey) :=
        find i2 <= N_keys suchthat defined(seed[i2]) && pk = ml_pkgen(seed[i2]) then (
          r <-R ml_encapseed;
          let ml_pair(junk, c) = ml_encap_r(pk, r) in
          s <-R ml_secret;
          insert ML_challenge(i2, c, s);
          return(ml_pair(s, c)) )
        else ( r <-R ml_encapseed; return(ml_encap_r(pk, r)) ).

(* HKDF info binds BOTH ciphertext portions and the context, as an injective
   transcript: info = encode(PROTOCOL_ID||"|aes|", SHA3-256(x25519_ct||mlkem_ct),
   context). SHA3-256's collision resistance is exactly what makes this map
   injective (distinct ciphertexts -> distinct info); we model that binding
   directly as an injective [data] encoding. Exposing SHA3's concrete collision
   term P_sha3 as a separate primitive is a refinement (see review 017-R / F1);
   here the binding is assumed collision-free via injectivity. *)
type x_ciphertext [fixed].
fun kdf_info(x_ciphertext, ml_ciphertext, bitstring): bitstring [data].

(* Combiner KDF as a random oracle over (ss1, ss2, info). *)
type hashkey [fixed].
type kdfkey  [fixed, large].
expand ROM_hash_3(hashkey, bitstring, ml_secret, bitstring, kdfkey, kdf, kdf_oracle, N_kdf).

query secret K.

proof {
  crypto mlkem_indcca2_assumption;
  crypto rom(kdf);
  simplify;
  success
}

process
  Ostart() :=
    hk  <-R hashkey;
    seed <-R ml_keyseed;
    let pk = ml_pkgen(seed) in
    r <-R ml_encapseed;
    let ml_pair(ss2: ml_secret, ct: ml_ciphertext) = ml_encap_r(pk, r) in
    (* Commit the challenge X25519 ciphertext at setup, as IND-CCA2 requires the
       challenge ciphertext to be fixed BEFORE decap queries. (X25519 is broken, so
       its ct is arbitrary/adversary-known — committing it does not weaken the game;
       it prevents the adversary from decapsulating (ct1*, ct) then declaring that
       same ct1* the challenge.) *)
    ct1star <-R x_ciphertext;
    return(pk, ct, ct1star);         (* publish pk, ML-KEM challenge ct, X25519 challenge ct *)
  (
    (run kdf_oracle(hk))
  | (* Full hybrid-ciphertext CCA decapsulation. Rejects ONLY the exact challenge
       pair ct1-star / ct2-star; permits [ct1' != ct1-star, ct2-star] and answers
       via the ciphertext-bound KDF over the query transcript. *)
    (foreach id <= N_dec do
      ODecap(ct1q: x_ciphertext, ss1q: bitstring, c: ml_ciphertext, ctxq: bitstring) :=
        if ct1q = ct1star && c = ct then yield else
        let ml_injbot(ss2q: ml_secret) = ml_decap(c, ml_skgen(seed)) in (
          let infoq: bitstring = kdf_info(ct1q, c, ctxq) in
          return(kdf(hk, ss1q, ss2q, infoq))
        ) else yield)
  | (* One challenge: X25519 broken => adversary supplies ss1 and the X25519
       ciphertext ct1; K binds both ciphertexts via SHA3 + info. Adversary gets ct
       (published), never K. *)
    (OChal(ss1: bitstring, context: bitstring) :=
      let info: bitstring = kdf_info(ct1star, ct, context) in
      let K: kdfkey = kdf(hk, ss1, ss2, info) in
      yield)
  )
