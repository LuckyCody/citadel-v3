# Citadel API Server — Environment Configuration
# Copy to .env:  cp env.example .env
# Never commit .env to version control.
#
# Two deployment modes:
#   Development:  Set CITADEL_ENV=development + CITADEL_ALLOW_PLAINTEXT_KEYS=1
#   Production:   Set CITADEL_MASTER_KEY + CITADEL_REPLAY_STORE + CITADEL_ENV=production

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# 256-bit master key for at-rest key wrapping (AES-256-GCM).
# Generate: openssl rand -hex 32
# NEVER commit this value. Use Docker Secrets or a secrets manager.
CITADEL_MASTER_KEY=

# Deployment environment. Controls startup gate behavior.
# "production" — requires CITADEL_MASTER_KEY and CITADEL_REPLAY_STORE
# "development" — allows plaintext keys and memory replay (local dev only)
CITADEL_ENV=production

# Replay store backend. Required unless CITADEL_ENV=development.
# "file"  — single-node, restart-safe (recommended for most deployments)
# "redis" — multi-node distributed (requires redis-backend feature + CITADEL_REDIS_URL)
CITADEL_REPLAY_STORE=file

# Path for file-based replay store (when CITADEL_REPLAY_STORE=file)
CITADEL_REPLAY_STORE_PATH=/data/replay.json

# API key authentication (use hash — never store plaintext key)
# Generate: cargo run --bin hash-apikey -- --generate
# Set the HASH here; give the plaintext key to API clients.
CITADEL_API_KEY_HASH=

# ---------------------------------------------------------------------------
# OPTIONAL — PRODUCTION
# ---------------------------------------------------------------------------

# Listen port (default: 8443)
CITADEL_PORT=8443

# Data directory for key storage and audit log (default: ./citadel-data)
CITADEL_DATA_DIR=/data

# Seed a demo key hierarchy on first run. NEVER true in production.
CITADEL_SEED_DEMO=false

# CORS — allow specific browser origin (leave unset to deny all CORS)
# CITADEL_CORS_ALLOW_ORIGIN=https://dashboard.example.com

# Rate limiting
CITADEL_RATE_LIMIT_RPS=100
CITADEL_RATE_LIMIT_BURST=200

# ---------------------------------------------------------------------------
# REDIS (only when CITADEL_REPLAY_STORE=redis)
# Build with: cargo build --release -p citadel-api --features redis-backend
# ---------------------------------------------------------------------------

# CITADEL_REDIS_URL=redis://localhost:6379
# CITADEL_REDIS_PREFIX=citadel:replay:
# CITADEL_REPLAY_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# DEVELOPMENT ONLY — not for any other environment
# ---------------------------------------------------------------------------

# Permit plaintext key storage without CITADEL_MASTER_KEY.
# Requires BOTH variables set. Any other combination causes fatal error.
# CITADEL_ALLOW_PLAINTEXT_KEYS=1
# CITADEL_ENV=development
